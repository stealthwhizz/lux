# Copy to deploy/.env (mode 0600). Every variable is described in
# docs/self-hosting.md.

# Required. Use letters and digits only, e.g. the output of: openssl rand -hex 24
LUX_DB_PASSWORD=

# The URL agent runtimes use to reach this server. The default works when
# runs execute inside the luxd container.
# LUX_PUBLIC_URL=http://127.0.0.1:7878

# Agents run inside the luxd container as its user, with no isolation from
# luxd or from each other. Leave false unless you trust every agent
# repository you import. With no executor enabled, tasks fail with a clear error.
LUX_ALLOW_LOCAL_EXECUTOR=false

# Model providers: set the keys you use. Keys stay in luxd; agents never see them.
# LUX_ANTHROPIC_API_KEY=
# LUX_OPENAI_API_KEY=
# LUX_LYZR_API_KEY=
# LUX_OLLAMA_BASE_URL=http://host.containers.internal:11434/v1
# LUX_OLLAMA_DISABLED=true

# Git credentials, referred to by name (here "github") when adding
# repositories or private agents. See docs/git-workflows.md.
# LUX_GIT_CREDENTIAL_GITHUB=
