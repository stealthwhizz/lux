{
  "name": "lux-desktop",
  "productName": "Lux",
  "version": "0.1.0",
  "description": "Lux desktop client: manage, run and supervise AI agents",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "node scripts/test-unit.mjs",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react-markdown": "10.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
